{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Planner",
  "version": "1.0.0",
  "identifier": "ir.planner.app",
  "build": {
    "frontendDist": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "پلنر جامع",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 600,
        "url": "http://localhost:3000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
